# ── App ───────────────────────────────────────────────────────────────────────
# NODE_ENV: development | test | production  (default: development)
NODE_ENV=development
# PORT: HTTP server port  (default: 4000)
PORT=4000
# APP_VERSION: shown in health-check response  (default: 1.0.0)
APP_VERSION=1.0.0
# LOG_LEVEL: fatal | error | warn | info | debug | trace  (default: info)
LOG_LEVEL=debug
# API_VERSION: prefix for all routes, e.g. api/v1
API_VERSION=api/v1

# ── Database ──────────────────────────────────────────────────────────────────
# Full PostgreSQL connection string — must be a valid URL
POSTGRES_URI=postgresql://<user>:<password>@<host>/<db>?sslmode=require

# ── Redis ─────────────────────────────────────────────────────────────────────
# Full Redis connection URL — must be a valid URL
REDIS_URI=redis://:<password>@<host>:<port>
# REDIS_HOST and REDIS_PORT are used separately by ioredis for the rate-limiter store
REDIS_HOST=<redis_host>
REDIS_PORT=6379
# REDIS_PASSWORD: leave blank if your Redis instance has no auth
REDIS_PASSWORD=<redis_password>

# ── Auth / JWT ────────────────────────────────────────────────────────────────
# JWT_SECRET: must be at least 64 characters, max 512
# Generate one with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=<min_64_char_random_secret>

# ── CORS / Cookies ────────────────────────────────────────────────────────────
# CORS_ORIGIN: comma-separated list of allowed frontend origins (no trailing slash)
CORS_ORIGIN=http://localhost:3000
# COOKIE_DOMAIN: set to your root domain in production (e.g. .syntheview.ai)
# Leave blank for localhost development
COOKIE_DOMAIN=

# ── Email (Brevo SMTP relay) ─────────────────────────────────────────────────
# Registration, OTP verification, password reset and email change all send mail,
# so every value in this block is required — a missing one stops the process at
# boot instead of silently dropping OTPs.
#
# Setup:
#   1. Create an account at https://www.brevo.com (the free tier sends 300 mails
#      a day, which is ample for this project).
#   2. Transactional → SMTP: copy the server and port, then create an "SMTP key".
#      The key is the password; the login is your Brevo account email.
#   3. Senders, Domains & Dedicated IPs: add and verify the address used in
#      EMAIL_FROM, or authenticate its whole domain with the DNS records Brevo
#      provides. The relay rejects an unverified sender.
#   4. Fill in the values below and start the backend. The boot log prints either
#      "Mail transport verified successfully." or the reason it failed.
#   5. Check delivery by registering an account (the OTP mail) and by using
#      "Forgot password" on the sign-in screen.
#
# 587 is STARTTLS and is what the app expects; 465 switches to implicit TLS.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
# The SMTP key's login — your Brevo account email, not the key.
SMTP_USER=<brevo_account_email>
# The SMTP key from Transactional → SMTP. Not your account password.
SMTP_PASSWORD=<brevo_smtp_key>
# Sender identity for every mail; must be a verified sender (or verified domain).
EMAIL_FROM=<verified_sender_address>
EMAIL_FROM_NAME=SynthView AI

# ── AI Providers (optional — falls back to stub if not set) ───────────────────
# Without these keys the AI module uses a built-in stub that returns generic
# questions. Set at least one to enable real LLM-powered question generation
# and answer evaluation.
#
# Both SDK clients are constructed once per process and reused for every call, so
# a key change requires a restart. Per-call timeouts and timings are in
# backend/src/integrations/ai/provider.ts — the `[ai] model responded` log line
# carries elapsedMs per provider and operation.
#
# Groq (fast, free tier available): https://console.groq.com
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
# Mistral (free tier available): https://console.mistral.ai
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest
# Embeddings model used for semantic retrieval. This is a different model family
# from the chat model above — mistral-embed has no chat equivalent and vice
# versa — so it is configured separately.  (default: mistral-embed)
MISTRAL_EMBED_MODEL=mistral-embed
