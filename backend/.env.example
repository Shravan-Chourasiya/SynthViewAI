# ── App ───────────────────────────────────────────────────────────────────────
# NODE_ENV: development | test | production  (default: development)
NODE_ENV=development
# PORT: HTTP server port  (default: 4000)
PORT=4000
# APP_VERSION: shown in health-check response  (default: 1.0.0)
APP_VERSION=1.0.0
# LOG_LEVEL: fatal | error | warn | info | debug | trace  (default: info)
LOG_LEVEL=debug
# API_VERSION: prefix for all routes, e.g. api/v1
API_VERSION=api/v1

# ── Database ──────────────────────────────────────────────────────────────────
# Full PostgreSQL connection string — must be a valid URL
POSTGRES_URI=postgresql://<user>:<password>@<host>/<db>?sslmode=require

# ── Redis ─────────────────────────────────────────────────────────────────────
# Full Redis connection URL — must be a valid URL
REDIS_URI=redis://:<password>@<host>:<port>
# REDIS_HOST and REDIS_PORT are used separately by ioredis for the rate-limiter store
REDIS_HOST=<redis_host>
REDIS_PORT=6379
# REDIS_PASSWORD: leave blank if your Redis instance has no auth
REDIS_PASSWORD=<redis_password>

# ── Auth / JWT ────────────────────────────────────────────────────────────────
# JWT_SECRET: must be at least 64 characters, max 512
# Generate one with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=<min_64_char_random_secret>

# ── CORS / Cookies ────────────────────────────────────────────────────────────
# CORS_ORIGIN: comma-separated list of allowed frontend origins (no trailing slash)
CORS_ORIGIN=http://localhost:3000
# COOKIE_DOMAIN: set to your root domain in production (e.g. .syntheview.ai)
# Leave blank for localhost development
COOKIE_DOMAIN=

# ── Gmail OAuth2 (Nodemailer) ─────────────────────────────────────────────────
# Used for sending OTP and verification emails
# Set up at: https://console.cloud.google.com → OAuth 2.0 credentials
GMAIL_USER_EMAIL=<your_gmail_address>
GMAIL_CLIENT_ID=<google_oauth_client_id>
GMAIL_CLIENT_SECRET=<google_oauth_client_secret>
GMAIL_REFRESH_TOKEN=<google_oauth_refresh_token>
# Optional alternative to OAuth. Create a 16-character app password after
# enabling 2-Step Verification for the Gmail account.
GMAIL_APP_PASSWORD=<gmail_app_password>

# ── AI Providers (optional — falls back to stub if not set) ───────────────────
# Without these keys the AI module uses a built-in stub that returns generic
# questions. Set at least one to enable real LLM-powered question generation
# and answer evaluation.
#
# Groq (fast, free tier available): https://console.groq.com
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
# Mistral (free tier available): https://console.mistral.ai
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest
